{
 "spec": {
  "in": null,
  "out": {
   "modes": [
    "translate",
    "mutate",
    "divergence",
    "tm",
    "align",
    "dotplot",
    "digest",
    "protein",
    "crispr"
   ],
   "tables": {
    "translate": {
     "mode": "enum:translate|mutate|divergence|tm|align|dotplot|digest|protein|crispr!",
     "table": "int:1:33",
     "frame": "numx",
     "start": "enum:atg|alt|any",
     "minLen": "numx",
     "nested": "bool",
     "partial": "bool",
     "cds": "bool",
     "toStop": "bool",
     "gc": "enum:remove|ignore|weighted",
     "window": "numx",
     "exons": {
      "$list": {
       "$obj": {
        "start": "numx!",
        "end": "numx!"
       }
      },
      "max": 20
     },
     "refUsage": {
      "$list": "nonneg",
      "min": 64,
      "max": 64
     }
    },
    "mutate": {
     "mode": "enum:translate|mutate|divergence|tm|align|dotplot|digest|protein|crispr!",
     "table": "int:1:33",
     "variants": {
      "$req": true,
      "$list": {
       "$obj": {
        "kind": "enum:sub|del|ins|dup|delins!",
        "pos": "numx!",
        "end": "numx",
        "altIndex": "numx"
       }
      },
      "min": 1,
      "max": 16
     },
     "enzymes": {
      "$list": "id",
      "max": 10
     }
    },
    "divergence": {
     "mode": "enum:translate|mutate|divergence|tm|align|dotplot|digest|protein|crispr!",
     "coding": "bool",
     "table": "int:1:33"
    },
    "tm": {
     "mode": "enum:translate|mutate|divergence|tm|align|dotplot|digest|protein|crispr!",
     "na": "numx",
     "k": "numx",
     "tris": "numx",
     "mg": "numx",
     "dntp": "numx",
     "c1": "numx",
     "c2": "numx",
     "saltCorr": "enum:none|schildkraut|santalucia|owczarzy2004|owczarzy2008",
     "nn": "enum:santalucia1998|santalucia2004",
     "selfComp": "enum:auto|yes|no",
     "tMin": "numx",
     "tMax": "numx",
     "mismatches": "numx"
    },
    "align": {
     "mode": "enum:translate|mutate|divergence|tm|align|dotplot|digest|protein|crispr!",
     "type": "enum:global|local|semiglobal",
     "alphabet": "enum:auto|dna|protein",
     "matrix": "enum:BLOSUM62|BLOSUM50|PAM250|none",
     "match": "numx",
     "mismatch": "numx",
     "gap": "numx",
     "open": "numx",
     "extend": "numx",
     "shuffles": "numx",
     "band": "numx"
    },
    "dotplot": {
     "mode": "enum:translate|mutate|divergence|tm|align|dotplot|digest|protein|crispr!",
     "window": "numx",
     "stringency": "numx",
     "revcomp": "bool"
    },
    "digest": {
     "mode": "enum:translate|mutate|divergence|tm|align|dotplot|digest|protein|crispr!",
     "enzymes": {
      "$req": true,
      "$list": "id",
      "min": 1,
      "max": 10
     },
     "custom": {
      "$list": {
       "$obj": {
        "name": "id!",
        "cut": "int:-40:60!",
        "cut2": "int:-40:60"
       }
      },
      "max": 6
     },
     "circular": "bool",
     "ladder": "enum:none|1kb|100bp|lambda",
     "agarose": "numx",
     "dam": "bool",
     "dcm": "bool",
     "features": {
      "$list": {
       "$obj": {
        "start": "numx!",
        "end": "numx!",
        "key": "key!",
        "strand": "enum:+|-"
       }
      },
      "max": 16
     }
    },
    "protein": {
     "mode": "enum:translate|mutate|divergence|tm|align|dotplot|digest|protein|crispr!",
     "ph": "numx",
     "window": "numx",
     "wheel": "numx",
     "pk": "enum:bjellqvist|emboss|lehninger|solomon|sillero"
    },
    "crispr": {
