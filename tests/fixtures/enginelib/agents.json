        "init": "rnd*2"
       },
       "fine": {
        "init": "0"
       }
      },
      "rules": [
       {
        "do": "set",
        "var": "speed",
        "expr": "fine > 0 ? rnd : rnd*2"
       },
       {
        "do": "set",
        "var": "fine",
        "expr": "fine",
        "when": "speed > 1",
        "act": "speeding"
       }
      ]
     }
    ],
    "norms": [
     {
      "id": "limit",
      "kind": "F",
      "act": "speeding",
      "breed": "car",
