  {
   "format": "noema.sim-spec/v1",
   "engine": "agents@1",
   "title": "title",
   "params": [],
   "model": {
    "space": {
     "kind": "grid",
     "nx": 30,
     "ny": 30,
     "torus": false,
     "neighbourhood": "moore",
     "capacity": 5
    },
    "globals": {
     "rate": 0.1
    },
    "patches": {
     "vars": {
      "food": "px/30"
     },
     "rules": [
      {
       "var": "food",
       "expr": "min(1, food + rate)"
      }
     ],
     "diffuse": [
      {
       "var": "food",
       "rate": "0.1"
      }
     ]
    },
    "breeds": [
     {
      "id": "ant",
      "count": 50,
      "vars": {
       "en": {
        "init": "5"
       }
      },
      "rules": [
       {
        "do": "move",
        "how": "gradient",
        "patch": "food",
        "vision": "2"
       },
       {
        "do": "eat",
        "patch": "food",
        "amount": "0.5",
        "into": "en"
       },
       {
        "do": "set",
        "var": "en",
        "expr": "en - 0.3"
       },
       {
        "do": "die",
        "when": "en < 0"
       },
       {
        "do": "reproduce",
        "when": "en > 10",
        "share": {
         "en": 0.5
        }
       }
      ]
     }
    ],
    "reporters": [
     {
      "id": "ants",
      "fn": "count"
     },
     {
      "id": "meanE",
      "fn": "mean",
      "expr": "en"
     },
     {
      "id": "totalFood",
      "of": "patches",
      "fn": "sum",
      "expr": "food"
     }
    ],
    "steps": 100,
    "schedule": "random",
    "stop": "ants == 0"
   },
   "outputs": [
    {
     "id": "a",
     "kind": "series",
     "of": "reporter",
     "reporter": "ants"
    },
    {
     "id": "sp",
     "kind": "scene",
     "of": "space",
     "patch": "food"
    },
    {
     "id": "o",
     "kind": "scalar",
     "of": "ops"
    }
   ]
  },
