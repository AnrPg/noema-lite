  {
   "format": "noema.sim-spec/v1",
   "engine": "agents@1",
   "title": "title",
   "params": [],
   "model": {
    "space": {
     "kind": "grid",
     "nx": 20,
     "ny": 20
    },
    "globals": {
     "goal": 10
    },
    "breeds": [
     {
      "id": "r",
      "count": 3,
      "vars": {
       "pos": {
        "init": "0"
       },
       "fuel": {
        "init": "5"
       }
      },
      "bdi": {
       "commitment": "open",
       "goals": [
        {
         "id": "reach",
         "when": "pos < goal",
         "achieved": "pos >= goal",
         "impossible": "fuel <= 0",
         "priority": "1"
        }
       ],
       "plans": [
        {
         "id": "step",
         "goal": "reach",
         "context": "fuel > 0",
         "body": [
          {
           "do": "set",
           "var": "pos",
           "expr": "pos + 1"
          },
          {
           "do": "set",
           "var": "fuel",
           "expr": "fuel - 1"
          }
         ]
        }
       ]
      }
     }
    ],
    "reporters": [
     {
      "id": "mp",
      "fn": "mean",
      "expr": "pos"
     }
    ],
    "steps": 20
   },
   "outputs": [
    {
     "id": "a",
     "kind": "scalar",
     "of": "bdi",
     "name": "achieved"
    },
    {
     "id": "d",
     "kind": "scalar",
     "of": "bdi",
     "name": "dropped"
    },
    {
     "id": "p",
     "kind": "series",
     "of": "reporter",
     "reporter": "mp"
    }
   ]
