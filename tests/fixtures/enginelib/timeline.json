    {
     "id": "olSub",
     "kind": "scalar",
     "of": "convert",
     "event": "battle",
     "to": "olympiad",
     "field": "oy"
    },
    {
     "id": "auc",
     "kind": "scalar",
     "of": "convert",
     "event": "battle",
     "to": "auc",
     "field": "y"
    },
    {
     "id": "am",
     "kind": "scalar",
     "of": "convert",
     "event": "battle",
     "to": "hebrew",
     "field": "y"
    },
    {
     "id": "nab",
