     "label": "day",
     "min": 1,
     "max": 28,
     "step": 1,
     "default": 1
    }
   ],
   "model": {
    "options": {
     "auc": "varro",
     "olympiadMonth": 7
    },
    "events": [
     {
      "id": "battle",
      "date": {
       "cal": "julian",
       "era": "bce",
       "y": "yb",
       "m": "mo",
       "d": "dy"
      },
      "label": "evBattle",
      "lane": 1
     },
     {
      "id": "marathon",
      "date": {
       "cal": "julian",
       "era": "bce",
       "y": 490,
       "m": 9,
       "d": 12
      },
      "sd": 10,
      "label": "evMarathon",
      "lane": 0
     }
    ],
    "periods": [
     {
      "id": "wars",
      "start": {
       "cal": "julian",
       "era": "bce",
       "y": 499
      },
      "end": {
       "cal": "julian",
       "era": "bce",
       "y": 449,
       "m": 12,
       "d": 31
      },
      "label": "perWars",
      "lane": 2
     }
    ],
    "axis": {
     "era": "julian",
     "from": {
      "cal": "julian",
      "era": "bce",
      "y": 560
     },
     "to": {
      "cal": "julian",
      "era": "bce",
      "y": 400
     },
