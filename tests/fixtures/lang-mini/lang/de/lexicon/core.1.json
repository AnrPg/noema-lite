     }
    ],
    "phrases": [
     {
      "text": "Das Auge isst mit.",
      "tr": "The eye eats too.",
      "kind": "saying",
      "meaning": "How food looks matters.",
      "register": "neutral"
     },
     {
      "text": "Es wird nichts so heiß gegessen, wie es gekocht wird.",
      "tr": "Nothing is eaten as hot as it is cooked.",
      "kind": "proverb",
      "meaning": "Things are rarely as bad as they first seem.",
      "register": "neutral"
     },
     {
      "text": "So jemand nicht will arbeiten, der soll auch nicht essen.",
      "tr": "If anyone will not work, neither shall he eat.",
