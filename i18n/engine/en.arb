  "engine.guide.friends.step3": "Each friend adds **their own free Gemini key** (guide: “Get your free Gemini API key”).",
  "@engine.guide.friends.step3": {
    "description": "Setup guide “Invite friends” (Account menu › ❓ Help): step 3. Markdown: keep **bold**, `code`, links and file names; use the same names for the app’s buttons and menus as your translation of them."
  },
  "engine.guide.friends.step4": "Want to give them one of your subjects? Subject picker → **🔗** on the subject → *Share with a person* (their e-mail) — they get a 🔔 and accept. Or **🌍 Make it public** so everybody finds it in Explore.",
  "@engine.guide.friends.step4": {
    "description": "Setup guide “Invite friends” (Account menu › ❓ Help): step 4. Markdown: keep **bold**, `code`, links and file names; use the same names for the app’s buttons and menus as your translation of them."
  },
  "engine.guide.friends.note1": "Supabase’s built-in email service sends only a few emails per hour: for more than a handful of friends, either turn off “Confirm email” (Authentication → Providers → Email) or connect your own SMTP.",
  "@engine.guide.friends.note1": {
    "description": "Setup guide “Invite friends” (Account menu › ❓ Help): note 1 (after 💡). Markdown: keep **bold**, `code`, links and file names; use the same names for the app’s buttons and menus as your translation of them."
