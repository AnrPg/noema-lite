{
  "@@locale": "en",
  "roadmap.fixing": "fixing {n, number} problem(s)…",
  "@roadmap.fixing": {
    "description": "Progress line (in the Roadmap’s log) while the AI repairs its answer after the app found problems in it. n = number of problems.",
    "placeholders": {
      "n": {
        "type": "int",
        "example": "3"
      }
    }
  },
  "roadmap.stepNotFound": "Step not found.",
  "@roadmap.stepNotFound": {
    "description": "Error: the step (a node of the Roadmap) no longer exists, e.g. it was removed on another device."
  },
  "roadmap.notFound": "Roadmap not found.",
  "@roadmap.notFound": {
    "description": "Error: the Roadmap (a learning map of steps) is not on this device."
  },
  "roadmap.stopped": "Stopped.",
  "@roadmap.stopped": {
    "description": "Message when the learner stopped re-planning the steps of a Roadmap."
  },
  "roadmap.build.dag": "Agent 1 — mapping every prerequisite of “{goal}”…",
  "@roadmap.build.dag": {
    "description": "Log line while the first AI agent builds the Roadmap. goal = the topic the learner wants to master.",
    "placeholders": {
      "goal": {
        "type": "String",
        "example": "Quantum computing"
      }
    }
  },
  "roadmap.build.fixingGraph": "fixing {n, number} problem(s) in the graph…",
  "@roadmap.build.fixingGraph": {
    "description": "Log line while the AI repairs the map (graph of steps) it made. n = number of problems.",
    "placeholders": {
      "n": {
        "type": "int",
        "example": "2"
      }
    }
  },
  "roadmap.build.dagDone": "{pre, number} prerequisites, {apps, number} applications, {links, number} links",
  "@roadmap.build.dagDone": {
    "description": "Log line after the first agent: how many prerequisite steps, application steps and links between steps the map has.",
    "placeholders": {
      "pre": {
        "type": "int",
        "example": "24"
      },
      "apps": {
        "type": "int",
        "example": "4"
      },
      "links": {
        "type": "int",
        "example": "40"
      }
    }
  },
  "roadmap.build.audit": "Agent 1b — independent check: are the prerequisites complete?",
  "@roadmap.build.audit": {
    "description": "Log line while a second AI agent checks the prerequisite steps of the map."
  },
  "roadmap.build.auditAdded": "added {n, number} missing prerequisite(s): {list}",
  "@roadmap.build.auditAdded": {
    "description": "Log line after the check: prerequisite steps that were added. list = their titles, comma-separated (may end with …).",
    "placeholders": {
      "n": {
        "type": "int",
        "example": "2"
      },
      "list": {
        "type": "String",
        "example": "Vectors, Probability"
      }
    }
  },
  "roadmap.build.auditNone": "nothing missing",
  "@roadmap.build.auditNone": {
    "description": "Log line after the check of the prerequisites: none was missing."
  },
  "roadmap.build.expand": "Agent 2 — expanding the goal “{goal}” into its full Roadmap ({depth, select, standard {standard} deep {deep} exhaustive {exhaustive} other {{depth}}})…",
  "@roadmap.build.expand": {
    "description": "Log line while the second AI agent expands the goal into many steps. goal = the goal’s title; depth = how deep the learner asked for (standard, deep or exhaustive).",
    "placeholders": {
      "goal": {
        "type": "String",
        "example": "Quantum computing"
      },
      "depth": {
        "type": "String",
        "example": "deep"
      }
    }
  },
  "roadmap.build.expandDone": "{aspects, number} aspects, {subtopics, number} sub-topics, {related, number} related topics + synthesis",
  "@roadmap.build.expandDone": {
    "description": "Log line after the goal was expanded: how many steps of each kind were made, plus one synthesis step.",
    "placeholders": {
      "aspects": {
        "type": "int",
        "example": "6"
      },
      "subtopics": {
        "type": "int",
        "example": "18"
      },
      "related": {
        "type": "int",
        "example": "3"
      }
    }
  },
  "roadmap.build.plan": "Agent 3 — planning the chapters of {n, number} nodes…",
  "@roadmap.build.plan": {
    "description": "Log line while the third AI agent plans the chapters of the steps (nodes). n = number of steps.",
    "placeholders": {
      "n": {
        "type": "int",
        "example": "30"
      }
    }
  },
  "roadmap.build.planProgress": "{done, number}/{total, number} nodes planned",
  "@roadmap.build.planProgress": {
    "description": "Log line: how many steps (nodes) of the Roadmap have their chapters planned so far.",
    "placeholders": {
      "done": {
        "type": "int",
        "example": "10"
      },
      "total": {
        "type": "int",
        "example": "30"
      }
    }
  },
  "roadmap.build.waitingApp": "Waiting for your Claude app to build the map (copy the message below into a Claude chat).",
  "@roadmap.build.waitingApp": {
    "description": "Log line: the learner chose their Claude app to build the Roadmap; it waits for that."
  },
  "roadmap.build.plannedByApp": "The chapters of the steps are planned by your Claude app.",
  "@roadmap.build.plannedByApp": {
    "description": "Log line: the learner’s Claude app plans the chapters of the Roadmap’s steps."
  },
  "roadmap.build.needKey": "Add a Claude API key (✨ Create with Claude → Here in noema-lite) or a Gemini key (⚙️ Settings) first.",
  "@roadmap.build.needKey": {
    "description": "Error when a Roadmap should be built in the app but no AI key is set. Names menu paths of the app."
  },
  "roadmap.build.attachFirst": "The map is ready. Attach the subjects you already have to its steps — then the other steps are planned.",
  "@roadmap.build.attachFirst": {
    "description": "Log line: the map is built; the learner first attaches subjects they already have to steps, then the other steps get chapter plans."
  },
  "roadmap.build.readyImported": "Ready: your map with {n, number} steps, every step planned.",
  "@roadmap.build.readyImported": {
    "description": "Log line when an imported Roadmap is complete. n = number of steps.",
    "placeholders": {
      "n": {
        "type": "int",
        "example": "12"
      }
    }
  },
  "roadmap.build.ready": "Ready: {n, number} nodes in three parts — prerequisites, the goal, applications.",
  "@roadmap.build.ready": {
    "description": "Log line when a Roadmap built by the agents is complete. n = number of steps (nodes).",
    "placeholders": {
      "n": {
        "type": "int",
        "example": "48"
      }
    }
  },
  "roadmap.gen.sharedBusy": "{state, select, ready {{known, select, yes {{who} has prepared this step — it is shared with you} other {Somebody has prepared this step — it is shared with you}}} other {{known, select, yes {{who} is preparing this step — it is shared with you} other {Somebody is preparing this step — it is shared with you}}}}",
  "@roadmap.gen.sharedBusy": {
    "description": "Progress line of a step in a shared Roadmap that another member prepared (state ready) or is preparing. who = their name; known = yes when the name is known.",
    "placeholders": {
      "state": {
        "type": "String",
        "example": "ready"
      },
      "known": {
        "type": "String",
        "example": "yes"
      },
      "who": {
        "type": "String",
        "example": "Maria"
      }
    }
  },
  "roadmap.gen.saving": "Saving the subject (this device + cloud)…",
  "@roadmap.gen.saving": {
    "description": "Progress line of a step: its new subject is being saved on this device and in the cloud account."
  },
  "roadmap.gen.ready": "Ready",
  "@roadmap.gen.ready": {
    "description": "Progress line of a step: its subject is ready. Very short."
  },
  "roadmap.gen.readyToStudy": "“{title}” is ready to study",
  "@roadmap.gen.readyToStudy": {
    "description": "Toast: the subject of a Roadmap step is ready. title = the step’s title.",
    "placeholders": {
      "title": {
        "type": "String",
        "example": "DNA replication"
      }
    }
  },
  "roadmap.gen.paused": "Paused.",
  "@roadmap.gen.paused": {
    "description": "Status of a step whose preparation the learner stopped (it can be resumed)."
  },
  "roadmap.gen.shareFailed": "The step is ready for you, but sharing it failed: {error} — it is tried again when you open the map.",
  "@roadmap.gen.shareFailed": {
    "description": "Toast in a shared Roadmap: the step was prepared but could not be published to the other members. error = the technical reason.",
    "placeholders": {
      "error": {
        "type": "String",
        "example": "Network error"
      }
    }
  },
  "roadmap.gen.fileMissing": "{name} is not available on this device — continuing without it",
