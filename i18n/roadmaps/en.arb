    "description": "Progress line: one of the learner’s files for this step is not on this device; the step is prepared without it. name = file name.",
    "placeholders": {
      "name": {
        "type": "String",
        "example": "chapter5.pdf"
      }
    }
  },
  "roadmap.gen.noPack": "Claude stopped without a pack",
  "@roadmap.gen.noPack": {
    "description": "Error: Claude (the AI) ended its work without producing the subject pack."
  },
