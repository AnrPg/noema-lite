{
  "name": "noema-lite",
  "private": true,
  "description": "noema-lite: the app, the connector and the tools (README.md)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prebuild": "npm run contracts",
    "build": "python3 tools/build.py",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "contracts": "node tools/contracts.mjs",
    "migrate": "node --experimental-strip-types --no-warnings tools/migrate/run.mjs",
    "test:unit": "node --test --experimental-strip-types --no-warnings \"src/**/*.test.ts\"",
    "check": "npm run contracts && npm run typecheck && npm run test:unit && npm run migrate -- --check"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "esbuild": "0.28.2",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "6.0.3"
  }
}
