{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noema-lite.netlify.app/schemas/noema.thermal.v1.schema.json",
  "title": "noema-lite thermal network (noema.thermal/v1)",
  "description": "The lumped thermal network run by the thermal engine thermal@1 (src/engines/thermal/thermal.js; docs/INTERACTIVE_ENGINES.md §2). Temperatures in °C, R in K/W, G in W/K, C in J/K, P in W, h in W/(m²·K), A in m². The engine's own check() (twin: tools/thermal.py) also tests what a schema cannot: ids unique across nodes, links, sources and thermostats; links to known nodes; no source on a fixed node; one thermostat per source; low < high; a group of massless nodes without a path to a boundary ('singular'); an insulated group ('floating', a warning); the limits (50 nodes, 200 links, 24 sources, 8 thermostats).",
  "type": "object",
  "required": ["nodes", "links"],
  "properties": {
    "format": {
      "const": "noema.thermal/v1"
    },
    "meta": {
      "type": "object",
      "description": "free notes for authors; ignored"
    },
    "ambient": {
      "type": "number",
      "exclusiveMinimum": -273.15,
      "default": 25,
      "description": "°C: the far side of every link without b, and every node's default T0"
    },
    "nodes": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_\\-]{0,31}$",
                "not": {
                  "const": "ambient"
                }
              },
              "C": {
                "type": "number",
                "minimum": 0,
                "description": "heat capacity J/K (0 or none: massless)"
              },
              "T0": {
                "type": "number",
                "exclusiveMinimum": -273.15,
                "description": "initial temperature °C (default: ambient)"
              },
              "label": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["id", "fixed"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_\\-]{0,31}$",
                "not": {
                  "const": "ambient"
                }
              },
              "fixed": {
                "type": "number",
                "exclusiveMinimum": -273.15,
                "description": "a boundary held at this temperature °C"
              },
              "label": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "links": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["id", "a"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_\\-]{0,31}$",
            "not": {
              "const": "ambient"
            }
          },
          "a": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_\\-]{0,31}$",
            "not": {
              "const": "ambient"
            }
          },
          "b": {
            "type": "string",
            "description": "a node id or 'ambient' (the default)"
          },
          "label": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "R": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "K/W"
          },
          "G": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "W/K"
          },
          "conv": {
            "type": "object",
            "description": "convection: q = h·A·(Ta − Tb)",
            "required": ["h", "A"],
            "properties": {
              "h": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "A": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "additionalProperties": false
          },
          "rad": {
            "type": "object",
            "description": "radiation: q = ε·σ·A·((Ta+273.15)⁴ − (Tb+273.15)⁴)",
            "required": ["eps", "A"],
            "properties": {
              "eps": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              },
              "A": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "additionalProperties": false
          }
        },
        "oneOf": [
          {
            "required": ["R"]
          },
          {
            "required": ["G"]
          },
          {
            "required": ["conv"]
          },
          {
            "required": ["rad"]
          }
        ],
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": ["id", "node", "P"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_\\-]{0,31}$",
            "not": {
              "const": "ambient"
            }
          },
          "node": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_\\-]{0,31}$",
            "not": {
              "const": "ambient"
            }
          },
          "P": {
            "$ref": "#/$defs/power"
          },
          "label": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "thermostats": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "description": "gates a source on/off with hysteresis: heat — on at T ≤ low, off at T ≥ high; cool — on at T ≥ high, off at T ≤ low",
        "required": ["id", "sensor", "source", "low", "high"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_\\-]{0,31}$",
            "not": {
              "const": "ambient"
            }
          },
          "sensor": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_\\-]{0,31}$",
            "not": {
              "const": "ambient"
            }
          },
          "source": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_\\-]{0,31}$",
            "not": {
              "const": "ambient"
            }
          },
          "low": {
            "type": "number"
          },
          "high": {
            "type": "number"
          },
          "mode": {
            "enum": ["heat", "cool"],
            "default": "heat"
          },
          "label": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "power": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "object",
          "required": ["step"],
          "properties": {
            "step": {
              "type": "object",
              "required": ["P"],
              "properties": {
                "P": {
                  "type": "number"
                },
                "t0": {
                  "type": "number",
                  "minimum": 0
                },
                "P0": {
                  "type": "number"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["pwm"],
          "properties": {
            "pwm": {
              "type": "object",
              "required": ["P", "freq", "duty"],
              "properties": {
                "P": {
                  "type": "number"
                },
                "freq": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "duty": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "low": {
                  "type": "number"
                },
                "delay": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["sine"],
          "properties": {
            "sine": {
              "type": "object",
              "required": ["amp", "freq"],
              "properties": {
                "offset": {
                  "type": "number"
                },
                "amp": {
                  "type": "number"
                },
                "freq": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "phase": {
                  "type": "number",
                  "description": "degrees"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
