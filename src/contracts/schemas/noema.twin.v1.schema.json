{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noema-lite.netlify.app/schemas/noema.twin.v1.schema.json",
  "title": "noema-lite IoT device twin (noema.twin/v1)",
  "description": "The device run by the twin engine twin@1 (src/engines/twin/twin.js). Units: capacity mAh, currents mA, times s, voltages V, rInt ohm (the whole pack), selfDischarge a fraction of the capacity per month, radio f Hz, d m, power dBm. Human-readable spec: docs/INTERACTIVE_ENGINES.md §5. The engine's check() (twin: tools/twin.py) also tests: duplicate sensor ids, a custom battery curve (soc 0 to 1, rising), sense shorter than the period, LoRa bandwidths and the event budget (code 'budget'). Faults (create's opts.faults, a bench fault's apply) are $defs.fault, checked by checkFaults.",
  "type": "object",
  "required": ["battery", "schedule", "sim"],
  "properties": {
    "format": {
      "const": "noema.twin/v1"
    },
    "battery": {
      "type": "object",
      "required": ["capacity"],
      "properties": {
        "capacity": {
          "$ref": "#/$defs/quantity",
          "description": "> 0"
        },
        "chem": {
          "enum": ["li-ion", "lifepo4", "alkaline", "nimh", "custom"]
        },
        "cells": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "curve": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": ["soc", "v"],
            "properties": {
              "soc": {
                "$ref": "#/$defs/quantity",
                "description": "0 to 1"
              },
              "v": {
                "$ref": "#/$defs/quantity",
                "description": "> 0"
              }
            },
            "additionalProperties": false
          }
        },
        "selfDischarge": {
          "$ref": "#/$defs/quantity",
          "description": "0 to 1"
        },
        "rInt": {
          "$ref": "#/$defs/quantity",
          "description": ">= 0"
        },
        "soc0": {
          "$ref": "#/$defs/quantity",
          "description": "0 to 1"
        },
        "cutoff": {
          "$ref": "#/$defs/quantity",
          "description": "> 0"
        },
        "tempCap": {
          "$ref": "#/$defs/quantity",
          "description": "0 to 1: the fraction of capacity lost per °C below 25 °C (default by chemistry)"
        }
      },
      "additionalProperties": false
    },
    "power": {
      "type": "object",
      "properties": {
        "sleep": {
          "$ref": "#/$defs/quantity",
          "description": ">= 0"
        },
        "active": {
          "$ref": "#/$defs/quantity",
          "description": ">= 0"
        },
        "sense": {
          "$ref": "#/$defs/quantity",
          "description": ">= 0"
        },
        "tx": {
          "$ref": "#/$defs/quantity",
          "description": ">= 0"
        },
        "rx": {
          "$ref": "#/$defs/quantity",
          "description": ">= 0"
        }
      },
      "additionalProperties": false
    },
    "schedule": {
      "type": "object",
      "required": ["period"],
      "properties": {
        "period": {
          "$ref": "#/$defs/quantity",
          "description": "> 0"
        },
        "sense": {
          "$ref": "#/$defs/quantity",
          "description": ">= 0"
        },
        "txEvery": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "ack": {
          "type": "boolean"
        },
        "rxWindow": {
          "$ref": "#/$defs/quantity",
          "description": ">= 0"
        },
        "retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "boot": {
          "$ref": "#/$defs/quantity",
          "description": ">= 0"
        }
      },
      "additionalProperties": false
    },
    "sensors": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_\\-]{0,31}$"
          },
          "base": {
            "$ref": "#/$defs/quantity",
            "description": "any finite number"
          },
          "amp": {
            "$ref": "#/$defs/quantity",
            "description": "any finite number"
          },
          "cycle": {
            "$ref": "#/$defs/quantity",
            "description": "> 0"
          },
          "noise": {
            "$ref": "#/$defs/quantity",
            "description": ">= 0"
          },
          "drift": {
            "$ref": "#/$defs/quantity",
            "description": "any finite number"
          },
          "current": {
            "$ref": "#/$defs/quantity",
            "description": ">= 0"
          },
          "tempco": {
            "$ref": "#/$defs/quantity",
            "description": "any finite number: the reading's shift per °C away from 25 °C"
          }
        },
        "additionalProperties": false
      }
    },
    "radio": {
      "type": "object",
      "properties": {
        "tech": {
          "enum": ["lora", "ble", "fsk"]
        },
        "f": {
          "$ref": "#/$defs/quantity",
          "description": "> 0"
        },
        "power": {
          "$ref": "#/$defs/quantity",
          "description": "any finite number"
        },
        "gain": {
          "$ref": "#/$defs/quantity",
          "description": "any finite number"
        },
        "d": {
          "$ref": "#/$defs/quantity",
          "description": "> 0"
        },
        "n": {
          "$ref": "#/$defs/quantity",
          "description": "> 0"
        },
        "d0": {
          "$ref": "#/$defs/quantity",
          "description": "> 0"
        },
        "sigma": {
          "$ref": "#/$defs/quantity",
          "description": ">= 0"
        },
        "extra": {
          "$ref": "#/$defs/quantity",
          "description": ">= 0"
        },
        "nf": {
          "$ref": "#/$defs/quantity",
          "description": ">= 0"
        },
        "sf": {
          "type": "integer",
          "minimum": 7,
          "maximum": 12
        },
        "bw": {
          "$ref": "#/$defs/quantity",
          "description": "> 0"
        },
        "cr": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "payload": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "bitrate": {
          "$ref": "#/$defs/quantity",
          "description": "> 0"
        },
        "txTime": {
          "$ref": "#/$defs/quantity",
          "description": "> 0"
        }
      },
      "additionalProperties": false
    },
    "brownout": {
      "type": "object",
      "properties": {
        "v": {
          "$ref": "#/$defs/quantity",
          "description": ">= 0"
        },
        "reset": {
          "$ref": "#/$defs/quantity",
          "description": ">= 0"
        }
      },
      "additionalProperties": false
    },
    "sim": {
      "type": "object",
      "required": ["duration"],
      "properties": {
        "duration": {
          "$ref": "#/$defs/quantity",
          "description": "> 0"
        },
        "samples": {
          "type": "integer",
          "minimum": 2,
          "maximum": 2000
        },
        "trace": {
          "$ref": "#/$defs/quantity",
          "description": ">= 0"
        },
        "maxEvents": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000000
        }
      },
      "additionalProperties": false
    },
    "meta": {
      "type": "object",
      "description": "free notes for authors; ignored"
    },
    "env": {
      "type": "object",
      "additionalProperties": false,
      "description": "the ambient temperature (°C): temp − swing·cos(2πt/cycle); cold lowers the capacity, raises rInt, slows self-discharge and the sleep current",
      "properties": {
        "temp": {
          "$ref": "#/$defs/quantity",
          "description": "°C (default 25)"
        },
        "swing": {
          "$ref": "#/$defs/quantity",
          "description": ">= 0, °C"
        },
        "cycle": {
          "$ref": "#/$defs/quantity",
          "description": "> 0, s (default 86400)"
        }
      }
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "description": "the crystal: ppm + tempco·(T − t0)²; a receive slot is missed when the clock error exceeds guard",
      "properties": {
        "ppm": {
          "$ref": "#/$defs/quantity",
          "description": "any finite number"
        },
        "tempco": {
          "$ref": "#/$defs/quantity",
          "description": "ppm/°C² (−0.034 for a tuning-fork crystal)"
        },
        "t0": {
          "$ref": "#/$defs/quantity",
          "description": "turnover temperature, °C (default 25)"
        },
        "guard": {
          "$ref": "#/$defs/quantity",
          "description": ">= 0, s (0 = no slots)"
        },
        "resync": {
          "$ref": "#/$defs/quantity",
          "description": ">= 0, s between beacons that reset the error (0 = only an acked delivery)"
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "description": "other devices on the same channel (pure ALOHA): their messages collide with this one's",
      "properties": {
        "nodes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        "period": {
          "$ref": "#/$defs/quantity",
          "description": "> 0, s (default: this device's)"
        },
        "airtime": {
          "$ref": "#/$defs/quantity",
          "description": "> 0, s (default: this device's)"
        },
        "jitter": {
          "$ref": "#/$defs/quantity",
          "description": "0 to 1 (1 = random phases, 0 = all wake in step)"
        },
        "capture": {
          "$ref": "#/$defs/quantity",
          "description": ">= 0, dB: a message this much stronger survives a collision"
        },
        "spread": {
          "$ref": "#/$defs/quantity",
          "description": ">= 0, dB"
        },
        "offset": {
          "$ref": "#/$defs/quantity",
          "description": "any finite number, dB"
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "quantity": {
      "description": "a number, or a string with an SI prefix: f p n u µ m k K M meg G (\"868M\", \"125k\")",
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "pattern": "^\\s*[-+]?(\\d+\\.?\\d*|\\.\\d+)([eE][-+]?\\d+)?\\s*(meg|[fpnuµmkKMG])?\\s*$"
        }
      ]
    },
    "fault": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": [
            "sensor-stuck",
            "sensor-drift",
            "battery-ageing",
            "antenna-detached",
            "wake-period",
            "brownout",
            "clock-drift",
            "sync-wake",
            "busy-channel",
            "sensor-tempco"
          ]
        },
        "sensor": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/quantity"
        },
        "at": {
          "$ref": "#/$defs/quantity"
        },
        "rate": {
          "$ref": "#/$defs/quantity"
        },
        "factor": {
          "$ref": "#/$defs/quantity"
        },
        "rInt": {
          "$ref": "#/$defs/quantity"
        },
        "loss": {
          "$ref": "#/$defs/quantity"
        },
        "period": {
          "$ref": "#/$defs/quantity"
        },
        "v": {
          "$ref": "#/$defs/quantity"
        },
        "ppm": {
          "$ref": "#/$defs/quantity",
          "description": "clock-drift: ppm added (default 200)"
        },
        "nodes": {
          "$ref": "#/$defs/quantity",
          "description": "sync-wake / busy-channel: the other nodes (default 5 / +50)"
        },
        "coef": {
          "$ref": "#/$defs/quantity",
          "description": "sensor-tempco: per °C (default 0.5)"
        }
      },
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "required": ["field", "expr"],
      "properties": {
        "field": {
          "enum": [
            "battery.capacity",
            "battery.cells",
            "battery.selfDischarge",
            "battery.rInt",
            "battery.soc0",
            "battery.cutoff",
            "power.sleep",
            "power.active",
            "power.sense",
            "power.tx",
            "power.rx",
            "schedule.period",
            "schedule.sense",
            "schedule.txEvery",
            "schedule.rxWindow",
            "schedule.retries",
            "schedule.boot",
            "radio.f",
            "radio.power",
            "radio.gain",
            "radio.d",
            "radio.n",
            "radio.d0",
            "radio.sigma",
            "radio.extra",
            "radio.nf",
            "radio.sf",
            "radio.bw",
            "radio.cr",
            "radio.payload",
            "radio.bitrate",
            "radio.txTime",
            "brownout.v",
            "brownout.reset",
            "sim.duration",
            "sim.samples",
            "sim.trace",
            "sim.maxEvents",
            "battery.tempCap",
            "env.temp",
            "env.swing",
            "env.cycle",
            "clock.ppm",
            "clock.tempco",
            "clock.t0",
            "clock.guard",
            "clock.resync",
            "network.nodes",
            "network.period",
            "network.airtime",
            "network.jitter",
            "network.capture",
            "network.spread",
            "network.offset"
          ]
        },
        "expr": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": ["scalar", "series"]
        },
        "of": {
          "enum": [
            "activeFraction",
            "airtime",
            "attempts",
            "chargeUsed",
            "clockErr",
            "clockErrMax",
            "collisions",
            "current",
            "dead",
            "delivered",
            "deliveryRatio",
            "eventCode",
            "eventT",
            "iAvg",
            "iAvgAnalytic",
            "lifeAnalytic",
            "lifeSim",
            "lost",
            "per",
            "ppmMean",
            "reading",
            "readingErr",
            "readingLast",
            "readingMean",
            "resets",
            "rssi",
            "rssiMean",
            "rxT",
            "sent",
            "slotMisses",
            "snrMean",
            "soc",
            "socEnd",
            "t",
            "tDead",
            "temp",
            "tempMax",
            "tempMean",
            "tempMin",
            "traceI",
            "traceT",
            "truth",
            "v",
            "vEnd",
            "vMin",
            "vload",
            "wakes"
          ],
          "description": "default: the id"
        },
        "sensor": {
          "type": "string",
          "description": "for readingMean, readingLast, readingErr, reading, truth (default: the first sensor)"
        }
      }
    }
  }
}
