{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noema-lite.netlify.app/schemas/noema.sources.v1.schema.json",
  "title": "noema-lite sources of a subject (sources.json, pack.sources)",
  "description": "The sources a subject was written from, in chronological order, and which source each chapter and patch file comes from. tools/CONTENT_SPEC.md \"sources.json\". A packaged file (sha256 set) travels in the .noema.zip as sources/<name>.",
  "type": "object",
  "required": ["sources"],
  "properties": {
    "_doc": { "type": "string" },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "chapters": { "type": "object", "propertyNames": { "pattern": "^ch[0-9]{2}$" }, "additionalProperties": { "type": "string" } },
    "patches": { "type": "object", "additionalProperties": { "type": "string" } }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,60}$", "x-message": "is not a source id (letters, digits, _ . -, at most 60)" },
        "title": { "type": "string" },
        "short": { "type": "string" },
        "subtitle": { "type": "string" },
        "pages": { "type": "string" },
        "file": { "type": "string" },
        "firstPage": { "type": "integer", "x-message": "must be a whole number" },
        "url": { "type": "string" },
        "added": { "type": "string" },
        "emoji": { "type": "string" },
        "fileName": { "type": "string" },
        "mime": { "type": "string" },
        "pageCount": { "type": "integer", "minimum": 0 },
        "size": { "type": "number" },
        "sha256": { "$ref": "noema.common.v1.schema.json#/$defs/sha256" }
      },
      "if": { "required": ["sha256"] },
      "then": {
        "required": ["file", "size"],
        "properties": {
          "file": { "pattern": "^sources/(?!\\.\\.(?:/|$))(?!.*/\\.\\.(?:/|$))[^/].*$", "x-message": "a packaged file must be \"sources/<name>\"" },
          "size": { "exclusiveMinimum": 0, "x-message": "must be a positive number of bytes" }
        }
      }
    }
  }
}
