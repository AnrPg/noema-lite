{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noema-lite.netlify.app/schemas/noema.pack.v3.schema.json",
  "title": "noema-lite subject pack (noema-pack, v 1–3)",
  "description": "A built subject pack (tools/build.py, make_pack.py, the Gemini generator, the connector): pack.json / the pack in IndexedDB and the cloud. Every version in use is accepted: v 1 (one language), v 2 (+ subject.i18n and translations), v 3 (the current format: + levels; what every build writes). This schema is what the app needs to open the pack; each chapter's own fields are checked against noema.chapter.v1 $defs/chapter (checkPack strict, src/features/content/domain/pack.ts; tools/validate.py). tools/CONTENT_SPEC.md \"Built pack\", docs/i18n.md §10.",
  "type": "object",
  "required": ["format", "subject", "chapters"],
  "properties": {
    "format": { "const": "noema-pack", "x-message": "must be \"noema-pack\"" },
    "v": { "enum": [1, 2, 3], "x-message": "must be 1, 2 or 3 (3: the current format)" },
    "subject": { "$ref": "noema.subject.v1.schema.json#/$defs/subject" },
    "sources": { "$ref": "noema.sources.v1.schema.json" },
    "chapters": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/chapter" }, "x-message": "no chapters" },
    "media": { "type": "object", "additionalProperties": { "$ref": "#/$defs/media" } },
    "counts": { "type": "object", "additionalProperties": { "type": "number" } },
    "builtAt": { "$ref": "noema.common.v1.schema.json#/$defs/isoTime" },
    "version": { "type": ["string", "null"] },
    "translations": { "$ref": "#/$defs/translations" },
    "activities": { "type": "object" },
    "requires": { "type": "array", "items": { "type": "string" } },
    "generatedBy": { "type": "string" },
    "curriculum": {
      "description": "the Roadmap step the pack was made for (engine/packgen.js): the Roadmap's id and the step's",
      "type": "object",
      "properties": { "id": { "type": "string" }, "node": { "type": "string" } }
    }
  },
  "$defs": {
    "chapter": {
      "description": "What the app needs of every chapter to open the pack (the full chapter: noema.chapter.v1).",
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "$ref": "noema.chapter.v1.schema.json#/$defs/chapterId" },
        "level": { "$ref": "noema.common.v1.schema.json#/$defs/levelId" },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "type": "string" },
              "level": { "$ref": "noema.common.v1.schema.json#/$defs/levelId" },
              "blocks": { "type": "array", "items": { "type": "object" } }
            }
          }
        },
        "exercises": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "type"],
            "properties": {
              "id": { "type": "string" },
              "type": { "$ref": "noema.chapter.v1.schema.json#/$defs/exerciseType" },
              "section": { "type": "string" },
              "level": { "$ref": "noema.common.v1.schema.json#/$defs/levelId" }
            }
          }
        },
        "flashcards": {
          "type": "array",
          "items": { "type": "object", "properties": { "level": { "$ref": "noema.common.v1.schema.json#/$defs/levelId" } } }
        },
        "debug": { "type": "array", "items": { "type": "object" } },
        "pitfalls": { "type": "array", "items": { "type": "object" } }
      }
    },
    "media": {
      "description": "One picture, embedded (data: URI) or fetched by the app from its url (\"fetch\": \"app\", docs/VISUAL.md §6).",
      "type": "object",
      "required": ["w", "h"],
      "properties": {
        "id": { "type": "string" },
        "w": { "type": "number", "exclusiveMinimum": 0, "x-message": "w/h missing" },
        "h": { "type": "number", "exclusiveMinimum": 0, "x-message": "w/h missing" },
        "data": { "type": "string" },
        "fetch": { "const": "app" },
        "url": { "type": "string" },
        "alt": { "type": "string" },
        "origin": { "type": "string" },
        "regions": { "type": "array", "items": { "$ref": "noema.visual.v1.schema.json#/$defs/region" } }
      },
      "allOf": [
        {
          "if": { "required": ["fetch"], "properties": { "fetch": { "const": "app" } }, "not": { "required": ["data"] } },
          "then": {
            "required": ["url"],
            "properties": { "url": { "pattern": "^https?://", "x-message": "a \"fetch\": \"app\" picture needs its image url" } }
          },
          "else": {
            "required": ["data"],
            "properties": { "data": { "pattern": "^data:image/", "x-message": "data must be a data:image/… URI" } }
          }
        },
        {
          "if": { "required": ["origin"], "properties": { "origin": { "const": "web" } } },
          "then": { "required": ["url"], "properties": { "url": { "minLength": 1, "x-message": "a web picture needs its source url" } } }
        }
      ]
    },
    "translations": {
      "description": "The pack's translations: each in its own file ({file: true, chapters: n}, noema.translation.v1) or, in older packs, inline.",
      "type": "object",
      "propertyNames": { "$ref": "noema.common.v1.schema.json#/$defs/locale" },
      "additionalProperties": {
        "type": "object",
        "if": { "required": ["file"], "properties": { "file": { "const": true } } },
        "then": {
          "required": ["chapters"],
          "properties": {
            "chapters": {
              "type": "integer",
              "minimum": 1,
              "x-message": "a translation in its own file says {\"file\": true, \"chapters\": <how many chapters it translates>}"
            }
          }
        },
        "else": {
          "required": ["chapters"],
          "properties": {
            "chapters": {
              "type": "array",
              "items": { "$ref": "#/$defs/chapter" },
              "x-message": "must be a list of chapters (or {\"file\": true, …} for a translation in its own file)"
            }
          }
        }
      }
    }
  }
}
