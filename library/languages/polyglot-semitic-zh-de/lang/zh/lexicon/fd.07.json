     },
     {
      "text": "吃不了兜着走",
      "tr": "what you can't eat you'll carry away",
      "kind": "idiom",
      "meaning": "you'll have to face the consequences",
      "register": "colloquial"
     }
    ],
    "synonyms": [
     {
      "word": "食",
      "register": "literary",
      "nuance": "classical word for eat; lives on in compounds (食物 food, 饮食 diet)"
