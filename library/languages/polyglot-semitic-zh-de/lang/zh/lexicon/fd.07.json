     {
      "word": "用",
      "register": "formal",
      "nuance": "polite, said to guests: 请慢用 = enjoy your meal"
     }
    ],
    "etymology": {
     "text": "Phono-semantic compound: semantic 口 (‘mouth’) + phonetic 乞.",
     "src": "Wiktionary (kaikki.org)"
    },
    "funFacts": [
     "吃了吗？(‘Have you eaten?’) is a greeting, like ‘How are you?’ — not an invitation to a meal."
    ],
    "pitfalls": [
     "Drinks take 喝, not 吃: 喝水, 喝茶 — and soup is drunk: 喝汤.",
     "吃 is used where English says ‘take’: 吃药 (take medicine)."
    ],
    "subtleties": [
     "吃 + an experience = to undergo it: 吃苦 (endure hardship), 吃亏 (lose out), 吃惊 (be startled)."
    ]
   }
