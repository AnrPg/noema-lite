      "def": "yes/no question marker (placed before the statement)",
      "register": [
       "neutral"
      ],
      "concept": "part.question"
     },
     {
      "id": "s2",
      "def": "shall we …? (suggestion)",
      "register": [
       "neutral"
      ],
      "of": "s1"
     }
    ],
    "examples": [
     {
      "text": "هَلْ تَتَكَلَّمُ الْعَرَبِيَّةَ؟",
