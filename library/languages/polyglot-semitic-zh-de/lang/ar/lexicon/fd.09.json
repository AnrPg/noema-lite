   "translit": "ʾa-",
   "role": "Question prefix (formal): written together with the first word, it turns a statement into a yes/no question (أَتُرِيدُ شَايًا؟); it is the one used before a negation (أَلَا، أَلَيْسَ) and in choice questions with أَمْ.",
   "ref": {
    "src": "Wiktionary (kaikki.org)",
    "checked": "2026-10-08"
   },
   "profile": {
    "frequency": "A2",
    "status": "current",
    "register": [
     "neutral"
    ],
    "connotation": "neutral",
    "feeling": "The short, classical way to ask — and the only way to ask “isn’t it?”.",
    "senses": [
     {
      "id": "s1",
      "def": "yes/no question prefix",
      "register": [
       "neutral"
      ],
      "concept": "part.question"
     },
     {
      "id": "s2",
      "def": "with أَمْ: which of the two? (a choice question)",
      "register": [
       "neutral"
      ],
      "of": "s1"
     }
    ],
    "examples": [
     {
      "text": "أَتُحِبُّ الْقَهْوَةَ؟",
      "tr": "Do you like coffee?",
      "register": "neutral",
      "context": "café",
      "sense": "s1"
     },
     {
      "text": "أَلَيْسَ هٰذَا بَيْتَكَ؟",
      "tr": "Isn’t this your house?",
      "register": "neutral",
      "context": "home",
      "sense": "s1"
     },
     {
      "text": "أَتَشْرَبُ شَايًا أَمْ قَهْوَةً؟",
      "tr": "Will you drink tea or coffee?",
      "register": "neutral",
      "context": "café",
      "sense": "s2"
     }
    ],
    "collocations": [
     {
      "text": "أَلَا …؟",
      "tr": "don’t …? (a negative question)"
     },
     {
      "text": "أَلَيْسَ …؟",
      "tr": "isn’t …?"
     },
     {
      "text": "أَ … أَمْ …؟",
      "tr": "… or …? (which one?)"
