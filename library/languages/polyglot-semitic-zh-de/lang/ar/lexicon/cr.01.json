     }
    ],
    "examples": [
     {
      "text": "اِسْتَيْقَظْتُ فِي السَّاعَةِ السَّادِسَةِ.",
      "tr": "I woke up at six.",
      "register": "neutral",
      "context": "daily routine",
      "sense": "s1"
     },
     {
      "text": "مَتَى تَسْتَيْقِظِينَ عَادَةً؟",
      "tr": "When do you (a woman) usually wake up?",
      "register": "neutral",
      "context": "conversation",
      "sense": "s1"
     },
     {
      "text": "اِسْتَيْقَظَ الطِّفْلُ فِي اللَّيْلِ.",
      "tr": "The child woke up in the night.",
      "register": "neutral",
      "context": "family",
      "sense": "s1"
     }
    ],
