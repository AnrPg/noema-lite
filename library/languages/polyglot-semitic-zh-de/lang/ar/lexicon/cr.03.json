    ],
    "examples": [
     {
      "text": "عِنْدِي خُطَّةٌ لِلْعُطْلَةِ.",
      "tr": "I have a plan for the holiday.",
      "register": "neutral",
      "context": "holidays",
      "sense": "s1"
     },
     {
      "text": "هٰذِهِ خُطَّةٌ جَيِّدَةٌ!",
      "tr": "This is a good plan!",
      "register": "neutral",
      "context": "conversation",
      "sense": "s1"
     },
     {
      "text": "غَيَّرْنَا الْخُطَّةَ بِسَبَبِ الْمَطَرِ.",
      "tr": "We changed the plan because of the rain.",
      "register": "neutral",
      "context": "weather",
      "sense": "s1"
     }
    ],
    "collocations": [
     {
      "text": "وَضَعَ خُطَّةً",
      "tr": "to make (draw up) a plan"
     },
     {
      "text": "خُطَّةُ عَمَلٍ",
      "tr": "an action plan, a work plan"
     }
    ],
    "phrases": [],
