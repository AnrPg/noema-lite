    {
     "a": "caesarea",
     "b": "alexandria",
     "mode": "coast"
    }
   ],
   "speeds": {
    "sea": "seaSpeed",
    "coast": "seaSpeed * 0.7"
   },
   "factor": 1.1
  }
 },
 "outputs": [
  {
   "id": "days",
   "kind": "scalar",
   "of": "route",
   "from": "roma",
   "to": "alexandria",
   "by": "days"
  },
  {
   "id": "km",
   "kind": "scalar",
   "of": "route",
   "from": "roma",
   "to": "alexandria",
   "by": "days",
   "what": "km"
  },
  {
   "id": "legs",
   "kind": "scalar",
   "of": "route",
   "from": "roma",
   "to": "alexandria",
   "by": "days",
   "what": "legs"
  },
  {
   "id": "cost",
   "kind": "scalar",
   "of": "route",
   "from": "roma",
   "to": "alexandria",
   "by": "days",
   "what": "cost"
  },
  {
   "id": "found",
   "kind": "scalar",
   "of": "route",
   "from": "roma",
   "to": "alexandria",
   "by": "days",
   "what": "found"
  },
  {
   "id": "cheapest",
   "kind": "scalar",
   "of": "route",
   "from": "roma",
   "to": "alexandria",
   "by": "cost",
   "what": "cost"
  },
  {
   "id": "direct",
   "kind": "scalar",
   "of": "distance",
   "from": "roma",
   "to": "alexandria",
   "unit": "km"
  },
  {
   "id": "miles",
   "kind": "scalar",
   "of": "distance",
   "from": "roma",
   "to": "alexandria",
   "unit": "romanMile"
  },
  {
   "id": "cumKm",
   "kind": "series",
   "of": "routeKm",
   "from": "roma",
   "to": "alexandria",
   "by": "days"
  },
  {
   "id": "cumDays",
   "kind": "series",
   "of": "routeDays",
   "from": "roma",
   "to": "alexandria",
   "by": "days"
  },
  {
   "id": "map",
   "kind": "scene",
   "of": "map",
   "path": {
    "from": "roma",
    "to": "alexandria",
    "by": "days"
   }
  }
 ],
 "readouts": [
  {
   "label": "daysLabel",
   "expr": "days",
   "unit": "d",
   "format": "fixed",
   "digits": 1
  },
  {
   "label": "kmLabel",
   "expr": "km",
   "unit": "km",
   "format": "auto",
   "digits": 4
  },
  {
   "label": "legsLabel",
   "expr": "legs",
   "format": "auto",
   "digits": 4
  },
  {
   "label": "costLabel",
   "expr": "cost / cheapest",
   "format": "fixed",
   "digits": 2
  },
  {
   "label": "directLabel",
   "expr": "direct",
   "unit": "km",
   "format": "auto",
   "digits": 4
  },
  {
   "label": "milesLabel",
   "expr": "miles",
   "format": "auto",
   "digits": 4
  }
 ],
 "plots": [
  {
   "kind": "scene",
   "of": "map",
   "title": "mapTitle",
   "height": 360
  },
  {
   "kind": "series",
   "title": "plotTitle",
   "x": {
    "series": "cumDays",
    "label": "daysAxis",
    "unit": "d"
   },
   "y": {
    "label": "kmAxis",
    "unit": "km",
    "min": 0
   },
   "series": [
    {
     "y": "cumKm",
     "label": "pathLine",
     "style": "points"
    }
   ]
  }
 ]
}