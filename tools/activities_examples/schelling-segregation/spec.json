{
 "format": "noema.sim-spec/v1",
 "engine": "agents@1",
 "title": "title",
 "intro": "intro",
 "consts": { "wantMax": 0.35 },
 "params": [
  { "id": "want", "kind": "slider", "label": "wantLabel", "min": 0, "max": 0.8, "step": 0.05, "default": 0.1 }
 ],
 "model": {
  "template": "schelling",
  "set": { "want": "want", "size": 20, "density": 0.9, "fracA": 0.5 },
  "steps": 60
 },
 "outputs": [
  { "id": "t", "kind": "series", "of": "t" },
  { "id": "sim", "kind": "series", "of": "reporter", "reporter": "similar" },
  { "id": "unh", "kind": "series", "of": "reporter", "reporter": "unhappy" },
  { "id": "similar", "kind": "scalar", "of": "final", "reporter": "similar" },
  { "id": "unhappy", "kind": "scalar", "of": "final", "reporter": "unhappy" },
  { "id": "rounds", "kind": "scalar", "of": "steps" },
  { "id": "grid", "kind": "scene", "of": "space", "colorBy": "group" }
 ],
 "readouts": [
  { "label": "similarLabel", "expr": "similar", "digits": 3 },
  { "label": "unhappyLabel", "expr": "unhappy", "digits": 3 },
  { "label": "roundsLabel", "expr": "rounds", "format": "auto" }
 ],
 "plots": [
  { "kind": "series", "title": "plotTitle",
    "x": { "series": "t", "label": "round" },
    "y": { "min": 0, "max": 1, "label": "share" },
    "series": [ { "y": "sim", "label": "similarLine" }, { "y": "unh", "label": "unhappyLine" } ] },
  { "kind": "scene", "title": "gridTitle", "of": "grid", "height": 320 }
 ]
}
