{
 "cases": [
  {
   "name": "a normal ventricle: EDV 135 mL, SV 79 mL, EF 59 %, MAP 97 mmHg",
   "steps": [ { "set": "ees", "value": 2.5 }, { "set": "pla", "value": 10 }, { "set": "r", "value": 1 } ],
   "expect": { "values": { "edv": [133, 137], "sv": [77, 81], "ef": [0.57, 0.6], "map": [95, 99], "co": [5.3, 5.7] } }
  },
  {
   "name": "systolic failure (Ees 1): the same filling, a smaller stroke volume, EF 37 %, MAP 60 mmHg",
   "steps": [ { "set": "ees", "value": 1 }, { "set": "pla", "value": 10 }, { "set": "r", "value": 1 } ],
   "expect": { "values": { "edv": [133, 137], "sv": [47, 51], "ef": [0.35, 0.38], "map": [58, 62] } }
  },
  {
   "name": "Frank–Starling: the weak ventricle filled to 16 mmHg ejects 79 mL again, but dilated to 210 mL with EF still 38 %",
   "steps": [ { "set": "ees", "value": 1 }, { "set": "pla", "value": 16 }, { "set": "r", "value": 1 } ],
   "expect": { "values": { "edv": [205, 215], "sv": [77, 81], "ef": [0.36, 0.39], "map": [94, 99] } }
  },
  {
   "name": "a doubled afterload: the pressure rises to 144 mmHg, the stroke volume falls to 61 mL",
   "steps": [ { "set": "ees", "value": 2.5 }, { "set": "pla", "value": 10 }, { "set": "r", "value": 2 } ],
   "expect": { "values": { "sv": [59, 63], "map": [141, 147], "esv": [72, 76] } }
  },
  {
   "name": "afterload reduction in failure (R 0.6): the weak ventricle ejects 62 mL instead of 49",
   "steps": [ { "set": "ees", "value": 1 }, { "set": "pla", "value": 10 }, { "set": "r", "value": 0.6 } ],
   "expect": { "values": { "sv": [60, 64], "map": [45, 49] } }
  },
  {
   "name": "explorer: the settings are saved",
   "steps": [ { "set": "ees", "value": 3 }, { "set": "pla", "value": 8 } ],
   "expect": { "state": [ "ees", "pla" ], "values": { "ef": [0.5, 0.75], "sw": [1000, 20000] } }
  }
 ]
