{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noema-lite.netlify.app/schemas/noema.circuit.v1.schema.json",
  "title": "noema-lite circuit netlist (noema.circuit/v1)",
  "description": "The netlist run by the circuit engine circuit-mna@1 (engine/src/36_engine_circuit.js). Human-readable spec: docs/activities-dev/circuit.md. The engine's own check() also tests what a schema cannot: unknown nodes, duplicate ids, voltage-source loops ('vloop'), nodes without a DC path to ground ('floating', a warning) and the limits (60 nodes, 200 elements).",
  "type": "object",
  "required": ["nodes", "elements"],
  "properties": {
    "format": { "const": "noema.circuit/v1" },
    "meta": { "type": "object", "description": "free notes for authors; ignored by the engine" },
    "nodes": {
      "type": "array",
      "maxItems": 120,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/nodeName" },
          {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "$ref": "#/$defs/nodeName" },
              "probe": { "$ref": "#/$defs/nodeName", "description": "makes this a probe-only label (a test point) of that node; it cannot be an element terminal" }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "elements": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/element" } }
  },
  "additionalProperties": false,
  "$defs": {
    "nodeName": { "type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_+\\-]{0,31}$", "description": "'gnd' and '0' are ground (they need not be listed)" },
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_\\-]{0,31}$" },
    "quantity": {
      "description": "a number, or a string with an SI prefix: f p n u µ m k K M meg G (\"4.7k\", \"100n\")",
      "oneOf": [
        { "type": "number" },
        { "type": "string", "pattern": "^\\s*[-+]?(\\d+\\.?\\d*|\\.\\d+)([eE][-+]?\\d+)?\\s*(meg|[fpnuµmkKMG])?\\s*$" }
      ]
    },
    "waveform": {
      "oneOf": [
        { "$ref": "#/$defs/quantity" },
        { "type": "object", "required": ["dc"], "properties": { "dc": { "$ref": "#/$defs/quantity" } }, "additionalProperties": false },
        {
          "type": "object", "required": ["pulse"], "additionalProperties": false,
          "properties": { "pulse": {
            "type": "object", "required": ["v1", "v2"], "additionalProperties": false,
            "properties": {
              "v1": { "$ref": "#/$defs/quantity" }, "v2": { "$ref": "#/$defs/quantity" },
              "delay": { "$ref": "#/$defs/quantity" }, "rise": { "$ref": "#/$defs/quantity" }, "fall": { "$ref": "#/$defs/quantity" },
              "width": { "$ref": "#/$defs/quantity" }, "period": { "$ref": "#/$defs/quantity" }
            } } }
        },
        {
          "type": "object", "required": ["sine"], "additionalProperties": false,
          "properties": { "sine": {
            "type": "object", "required": ["amp", "freq"], "additionalProperties": false,
            "properties": {
              "offset": { "$ref": "#/$defs/quantity" }, "amp": { "$ref": "#/$defs/quantity" }, "freq": { "$ref": "#/$defs/quantity" },
              "phase": { "type": "number", "description": "degrees" }, "delay": { "$ref": "#/$defs/quantity" }
            } } }
        },
        {
          "type": "object", "required": ["pwm"], "additionalProperties": false,
          "properties": { "pwm": {
            "type": "object", "required": ["v", "freq", "duty"], "additionalProperties": false,
            "properties": {
              "v": { "$ref": "#/$defs/quantity" }, "low": { "$ref": "#/$defs/quantity" }, "freq": { "$ref": "#/$defs/quantity" },
              "duty": { "type": "number", "minimum": 0, "maximum": 1 }, "delay": { "$ref": "#/$defs/quantity" }
            } } }
        }
      ]
    },
    "pins2": { "type": "array", "items": { "$ref": "#/$defs/nodeName" }, "minItems": 2, "maxItems": 2 },
    "pins3": { "type": "array", "items": { "$ref": "#/$defs/nodeName" }, "minItems": 3, "maxItems": 3 },
    "common": {
      "type": "object",
      "required": ["id", "type", "n"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "description": "authoring note (the activity's string tables hold what the learner reads)" },
        "note": { "type": "string" }
      }
    },
    "element": {
      "allOf": [{ "$ref": "#/$defs/common" }],
      "oneOf": [
        { "properties": { "type": { "enum": ["R"] }, "n": { "$ref": "#/$defs/pins2" }, "value": { "$ref": "#/$defs/quantity", "description": "ohms, > 0" } }, "required": ["value"] },
        { "properties": { "type": { "enum": ["C"] }, "n": { "$ref": "#/$defs/pins2" }, "value": { "$ref": "#/$defs/quantity", "description": "farads" }, "ic": { "$ref": "#/$defs/quantity", "description": "initial voltage n[0] − n[1]" } }, "required": ["value"] },
        { "properties": { "type": { "enum": ["L"] }, "n": { "$ref": "#/$defs/pins2" }, "value": { "$ref": "#/$defs/quantity", "description": "henries" }, "ic": { "$ref": "#/$defs/quantity", "description": "initial current n[0] → n[1]" } }, "required": ["value"] },
        { "properties": { "type": { "enum": ["V"] }, "n": { "$ref": "#/$defs/pins2" }, "value": { "$ref": "#/$defs/waveform", "description": "v(n[0]) − v(n[1])" } }, "required": ["value"] },
        { "properties": { "type": { "enum": ["I"] }, "n": { "$ref": "#/$defs/pins2" }, "value": { "$ref": "#/$defs/waveform", "description": "amperes driven into n[0] (out of n[1])" } }, "required": ["value"] },
        { "properties": { "type": { "enum": ["D"] }, "n": { "$ref": "#/$defs/pins2" },
          "preset": { "enum": ["1n4148", "1n4001", "led-red", "led-orange", "led-yellow", "led-green", "led-blue", "led-white"] },
          "params": { "type": "object", "properties": { "Is": { "$ref": "#/$defs/quantity" }, "n": { "type": "number", "exclusiveMinimum": 0 } }, "additionalProperties": false } } },
        { "properties": { "type": { "enum": ["SW"] }, "n": { "$ref": "#/$defs/pins2" }, "on": { "type": "boolean" },
          "params": { "type": "object", "properties": { "Ron": { "$ref": "#/$defs/quantity" }, "Roff": { "$ref": "#/$defs/quantity" } }, "additionalProperties": false } } },
        { "properties": { "type": { "enum": ["NPN", "PNP"] }, "n": { "$ref": "#/$defs/pins3", "description": "[collector, base, emitter]" },
          "preset": { "enum": ["2n3904", "2n2222", "bc547", "2n3906", "bc557"] },
          "params": { "type": "object", "properties": { "Is": { "$ref": "#/$defs/quantity" }, "betaF": { "type": "number", "exclusiveMinimum": 0 }, "betaR": { "type": "number", "exclusiveMinimum": 0 } }, "additionalProperties": false } } },
        { "properties": { "type": { "enum": ["NMOS", "PMOS"] }, "n": { "$ref": "#/$defs/pins3", "description": "[drain, gate, source]" },
          "preset": { "enum": ["2n7000", "bs170", "irlz44n", "bs250", "irf9540"] },
          "params": { "type": "object", "properties": { "Vth": { "type": "number" }, "k": { "type": "number", "exclusiveMinimum": 0 }, "lambda": { "type": "number", "minimum": 0 } }, "additionalProperties": false } } },
        { "properties": { "type": { "enum": ["OPAMP"] },
          "n": { "oneOf": [{ "$ref": "#/$defs/pins3" }, { "type": "array", "items": { "$ref": "#/$defs/nodeName" }, "minItems": 5, "maxItems": 5 }], "description": "[in+, in−, out] or [in+, in−, out, v+, v−] (supply pins set the rails)" },
          "params": { "type": "object", "properties": { "gain": { "type": "number", "exclusiveMinimum": 0 }, "rails": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }, "headroom": { "type": "number", "minimum": 0 } }, "additionalProperties": false } } }
      ],
      "unevaluatedProperties": false
    }
  }
}
