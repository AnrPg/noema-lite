{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noema-lite.netlify.app/schemas/noema.pid.v1.schema.json",
  "title": "noema-lite control loop (the model of pid@1)",
  "description": "The model of a sim-spec@1 spec whose engine is pid@1 (src/engines/pid/pid.js; docs/INTERACTIVE_ENGINES.md §3). The engine's own check() (twin: tools/pid.py) also tests what a schema cannot: uMin < uMax, Ts ≥ dt, the step budget (200000), bindings to fields that exist, steps ascending; and it warns on a step longer than half the plant's fastest time constant ('stiff'), anti-windup without limits and a controller without gain.",
  "type": "object",
  "required": [
    "plant",
    "transient"
  ],
  "properties": {
    "plant": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "K",
            "tau"
          ],
          "properties": {
            "type": {
              "const": "fopdt"
            },
            "K": {
              "type": "number"
            },
            "tau": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "y0": {
              "type": "number"
            },
            "theta": {
              "type": "number",
              "minimum": 0,
              "description": "dead time s"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "K",
            "wn",
            "zeta"
          ],
          "properties": {
            "type": {
              "const": "second"
            },
            "K": {
              "type": "number"
            },
            "wn": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "zeta": {
              "type": "number",
              "minimum": 0
            },
            "y0": {
              "type": "number"
            },
            "theta": {
              "type": "number",
              "minimum": 0,
              "description": "dead time s"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "K"
          ],
          "properties": {
            "type": {
              "const": "integrator"
            },
            "K": {
              "type": "number"
            },
            "y0": {
              "type": "number"
            },
            "theta": {
              "type": "number",
              "minimum": 0,
              "description": "dead time s"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "motor"
            },
            "J": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "b": {
              "type": "number",
              "minimum": 0
            },
            "Kt": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "R": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "L": {
              "type": "number",
              "minimum": 0
            },
            "output": {
              "enum": [
                "speed",
                "position"
              ]
            },
            "theta": {
              "type": "number",
              "minimum": 0,
              "description": "dead time s"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "C",
            "R"
          ],
          "properties": {
            "type": {
              "const": "thermal"
            },
            "C": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "R": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "Tamb": {
              "type": "number"
            },
            "y0": {
              "type": "number"
            },
            "theta": {
              "type": "number",
              "minimum": 0,
              "description": "dead time s"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "A",
            "k"
          ],
          "properties": {
            "type": {
              "const": "tank"
            },
            "A": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "k": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "h0": {
              "type": "number",
              "minimum": 0
            },
            "hMax": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "theta": {
              "type": "number",
              "minimum": 0,
              "description": "dead time s"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "controller": {
      "type": "object",
      "description": "parallel PID: u = u0 + Kp·(b·r − y) + I + D, D = Kd·s/(1 + s·Tf)·(c·r − y), Tf = |Kd/Kp|/N by default; u clamped to [uMin, uMax]",
      "properties": {
        "Kp": {
          "type": "number"
        },
        "Ki": {
          "type": "number"
        },
        "Kd": {
          "type": "number"
        },
        "N": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "Tf": {
          "type": "number",
          "minimum": 0
        },
        "b": {
          "type": "number"
        },
        "c": {
          "type": "number"
        },
        "uMin": {
          "type": "number"
        },
        "uMax": {
          "type": "number"
        },
        "antiWindup": {
          "enum": [
            "none",
            "clamp",
            "backcalc"
          ]
        },
        "Tt": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "Ts": {
          "type": "number",
          "minimum": 0
        },
        "u0": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "mode": {
      "enum": [
        "closed",
        "open"
      ],
      "default": "closed"
    },
    "setpoint": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "object",
          "required": [
            "step"
          ],
          "properties": {
            "step": {
              "type": "object",
              "required": [
                "to"
              ],
              "properties": {
                "from": {
                  "type": "number"
                },
                "to": {
                  "type": "number"
                },
                "at": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "ramp"
          ],
          "properties": {
            "ramp": {
              "type": "object",
              "required": [
                "slope"
              ],
              "properties": {
                "from": {
                  "type": "number"
                },
                "slope": {
                  "type": "number"
                },
                "at": {
                  "type": "number",
                  "minimum": 0
                },
                "until": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "sine"
          ],
          "properties": {
            "sine": {
              "type": "object",
              "required": [
                "amp",
                "freq"
              ],
              "properties": {
                "offset": {
                  "type": "number"
                },
                "amp": {
                  "type": "number"
                },
                "freq": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "phase": {
                  "type": "number"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "steps"
          ],
          "properties": {
            "steps": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "number"
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              }
            }
          },
          "additionalProperties": false
        }
      ],
      "description": "default 1 (a unit step at t = 0); in an open loop it is the plant's input"
    },
    "load": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "object",
          "required": [
            "step"
          ],
          "properties": {
            "step": {
              "type": "object",
              "required": [
                "to"
              ],
              "properties": {
                "from": {
                  "type": "number"
                },
                "to": {
                  "type": "number"
                },
                "at": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "ramp"
          ],
          "properties": {
            "ramp": {
              "type": "object",
              "required": [
                "slope"
              ],
              "properties": {
                "from": {
                  "type": "number"
                },
                "slope": {
                  "type": "number"
                },
                "at": {
                  "type": "number",
                  "minimum": 0
                },
                "until": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "sine"
          ],
          "properties": {
            "sine": {
              "type": "object",
              "required": [
                "amp",
                "freq"
              ],
              "properties": {
                "offset": {
                  "type": "number"
                },
                "amp": {
                  "type": "number"
                },
                "freq": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "phase": {
                  "type": "number"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "steps"
          ],
          "properties": {
            "steps": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "number"
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              }
            }
          },
          "additionalProperties": false
        }
      ],
      "description": "added to u at the plant's input"
    },
    "disturbance": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "object",
          "required": [
            "step"
          ],
          "properties": {
            "step": {
              "type": "object",
              "required": [
                "to"
              ],
              "properties": {
                "from": {
                  "type": "number"
                },
                "to": {
                  "type": "number"
                },
                "at": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "ramp"
          ],
          "properties": {
            "ramp": {
              "type": "object",
              "required": [
                "slope"
              ],
              "properties": {
                "from": {
                  "type": "number"
                },
                "slope": {
                  "type": "number"
                },
                "at": {
                  "type": "number",
                  "minimum": 0
                },
                "until": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "sine"
          ],
          "properties": {
            "sine": {
              "type": "object",
              "required": [
                "amp",
                "freq"
              ],
              "properties": {
                "offset": {
                  "type": "number"
                },
                "amp": {
                  "type": "number"
                },
                "freq": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "phase": {
                  "type": "number"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "steps"
          ],
          "properties": {
            "steps": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "number"
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              }
            }
          },
          "additionalProperties": false
        }
      ],
      "description": "added to the plant's output"
    },
    "noise": {
      "type": "object",
      "required": [
        "std"
      ],
      "properties": {
        "std": {
          "type": "number",
          "minimum": 0
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "properties": {
        "band": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.5,
          "default": 0.02
        }
      },
      "additionalProperties": false
    },
    "transient": {
      "type": "object",
      "required": [
        "tEnd"
      ],
      "properties": {
        "tEnd": {
          "oneOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "string",
              "minLength": 1,
              "description": "an expression of the spec's names"
            }
          ]
        },
        "dt": {
          "oneOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "string",
              "minLength": 1,
              "description": "an expression of the spec's names"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "bindings": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": [
          "element",
          "expr"
        ],
        "properties": {
          "element": {
            "enum": [
              "plant",
              "controller",
              "setpoint",
              "load",
              "disturbance",
              "noise"
            ]
          },
          "prop": {
            "type": "string"
          },
          "expr": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
