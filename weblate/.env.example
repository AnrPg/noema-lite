# Weblate for noema-lite — copy to weblate/.env ON THE SERVER and fill in. Never commit .env (it is in .gitignore).
# Every value below is a placeholder; no secret belongs in the repository. Reference:
# https://docs.weblate.org/en/latest/admin/install/docker.html

# ---------------------------------------------------------------- site
WEBLATE_SITE_DOMAIN=translate.example.com
WEBLATE_SITE_TITLE=noema-lite translations
WEBLATE_TIME_ZONE=Europe/Athens
ACME_EMAIL=you@example.com
WEBLATE_ADMIN_NAME=noema-lite admin
WEBLATE_ADMIN_EMAIL=you@example.com
# leave empty: the first start prints a random admin password in the log (docker compose logs weblate); change it in the UI
WEBLATE_ADMIN_PASSWORD=
WEBLATE_SERVER_EMAIL=weblate@example.com
WEBLATE_DEFAULT_FROM_EMAIL=weblate@example.com
WEBLATE_ALLOWED_HOSTS=translate.example.com

# private, invitation only: translators are invited by the owner and must accept the contributor agreement (weblate/CLA.md)
WEBLATE_REGISTRATION_OPEN=0
WEBLATE_REQUIRE_LOGIN=1
WEBLATE_DEFAULT_ACCESS_CONTROL=100
WEBLATE_DEFAULT_TRANSLATION_REVIEW=1

# ---------------------------------------------------------------- GitHub (pull requests to the private repo)
# A fine-grained personal access token limited to the noema-lite repository: Contents read/write, Pull requests read/write.
# Git itself uses Weblate's SSH key as a deploy key with write access (weblate/README.md "GitHub").
WEBLATE_GITHUB_USERNAME=your-github-user
WEBLATE_GITHUB_TOKEN=
WEBLATE_GITHUB_HOST=api.github.com

# ---------------------------------------------------------------- database
# A) temporary hosting: Supabase (a SEPARATE Supabase project, not the app's). Dashboard → Connect → "Session pooler"
#    (IPv4; port 5432). The transaction pooler (6543) is not suitable for Weblate.
POSTGRES_HOST=aws-0-<region>.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres.<project-ref>
POSTGRES_PASSWORD=
POSTGRES_SSL_MODE=require
POSTGRES_ALTER_ROLE=postgres
# close idle connections: the Supabase pooler has a small pool
POSTGRES_CONN_MAX_AGE=60
# B) own server (later): docker compose --profile localdb; then use instead
# POSTGRES_HOST=database
# POSTGRES_PORT=5432
# POSTGRES_DB=weblate
# POSTGRES_USER=weblate
# POSTGRES_PASSWORD=<long random>
# POSTGRES_SSL_MODE=disable
# (POSTGRES_ALTER_ROLE and POSTGRES_CONN_MAX_AGE can be removed)

# ---------------------------------------------------------------- e-mail (invitations, password resets, notifications)
WEBLATE_EMAIL_HOST=smtp.example.com
WEBLATE_EMAIL_PORT=587
WEBLATE_EMAIL_USE_TLS=1
WEBLATE_EMAIL_HOST_USER=
WEBLATE_EMAIL_HOST_PASSWORD=

# ---------------------------------------------------------------- size of the machine (2 vCPU / 4 GB RAM)
# 2 → 2 web workers + one Celery worker with 6 processes (≈ 10 database connections: fits the Supabase pooler's pool).
# Very little memory: CELERY_WORKER_MODE=single (slower background tasks).
WEBLATE_WORKERS=2
CLIENT_MAX_BODY_SIZE=100m
# 50 MB: the language-course facade files are up to ≈ 5 MB each
WEBLATE_TRANSLATION_UPLOAD_MAX_SIZE=52428800

# ---------------------------------------------------------------- the scripts (on YOUR computer, not on the server)
# tools/i18n/weblate_setup.py and weblate_import_drafts.py read these from the environment only:
#   export WEBLATE_URL=https://translate.example.com
#   export WEBLATE_API_TOKEN=wlu_…        (Weblate → your profile → API access)
